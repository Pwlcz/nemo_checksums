[Nemo Action]
Name=Verify from Clipboard
Name[pl]=Zweryfikuj ze schowka
Comment=Auto-detects hash type from clipboard and verifies the selected file
Comment[pl]=Automatycznie wykrywa typ sumy kontrolnej ze schowka i weryfikuje zaznaczony plik
Exec=<checksum_menu@pwlcz/verify_clipboard.sh %F>
Icon-Name=edit-paste-symbolic
Selection=S
Extensions=nodirs;
Dependencies=bash;xclip;zenity;
Quote=double
